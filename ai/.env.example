# ============================================================
# VEHISAFE AI SERVICE — Environment Template
# ============================================================
# Copy this file to ".env" and adjust values.
# NEVER commit .env to git.
# ============================================================

# --- Server ---
AI_HOST=127.0.0.1
AI_PORT=5000
AI_DEBUG=false

# --- Security ---
# Shared secret used by PHP to authenticate requests.
# MUST match the value in config/config.php (AI_API_KEY).
AI_API_KEY=change-me-vehisafe-dev-key-2025

# --- Logging ---
AI_LOG_LEVEL=INFO
AI_LOG_FILE=logs/ai_service.log

# --- Model paths (used from Phase 10 onwards) ---
AI_MODEL_DIR=models
AI_YOLO_MODEL=yolov8n.pt
AI_BLACKSPOT_MODEL=blackspot/model/blackspot_model.joblib

# --- Detection thresholds ---
# Confidence below this is treated as "uncertain"
AI_CONFIDENCE_THRESHOLD=0.55

# Seconds a driver must remain drowsy before we emit a violation
AI_DROWSINESS_SECONDS=2.0

# Seconds a driver's attention must be off-road before distraction
AI_DISTRACTION_SECONDS=3.0